{
  "name": "gluehlabor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "worker:dev": "wrangler dev --local --port 8787 --config worker/wrangler.toml",
    "worker:migrate": "wrangler d1 migrations apply becherwerk --local --config worker/wrangler.toml",
    "worker:seed": "tsx worker/scripts/seed.ts",
    "launch-check": "tsx scripts/launch-check.ts",
    "moderation": "tsx worker/scripts/moderation.ts"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "jsqr": "^1.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.164.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "dexie": "^4.4.7",
    "preact": "^10.29.8",
    "qrcode-generator": "^2.0.4"
  }
}
